# Copie este arquivo para .streamlit/secrets.toml para testar localmente
# contra o banco Postgres de producao, OU configure estas mesmas chaves
# em "Secrets" no painel do Streamlit Community Cloud ao publicar o app.
#
# NUNCA suba o arquivo .streamlit/secrets.toml (sem .example) para o Git.

DATABASE_URL = "postgresql://usuario:senha@host:5432/nome_do_banco"
APP_PASSWORD = "escolha-uma-senha-para-a-equipe"
